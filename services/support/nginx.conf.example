# Put limit_req_zone in nginx's http context once:
# limit_req_zone $binary_remote_addr zone=xauxat_support:1m rate=2r/s;
# Use a distinct TLS virtual host. Keep the existing Baraoteam hosts unchanged.
server {
    listen 443 ssl;
    server_name support.exsoria.pt;
    ssl_certificate /etc/letsencrypt/live/support.exsoria.pt/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/support.exsoria.pt/privkey.pem;
    access_log off;
    error_log /var/log/nginx/xauxat-support-error.log warn;
    client_max_body_size 24k;
    client_body_timeout 10s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=xauxat_support burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # The application has no need for the user's network address.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_request_buffering on;
        proxy_hide_header Server;
    }
}
