SUPPORT_PUBLIC_URL=https://support.exsoria.pt
# Set an existing monitored address before starting the service.
SUPPORT_CONTACT_EMAIL=
SUPPORT_DATABASE=/data/support.sqlite3
SUPPORT_RETENTION_DAYS=30
# Private SMTP credentials; never commit .env. TLS is mandatory.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASSWORD=
SUPPORT_FROM_EMAIL=
SUPPORT_ALERT_EMAIL=
