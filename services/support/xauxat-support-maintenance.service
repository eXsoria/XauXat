[Unit]
Description=XauXat support expiry and private inbox alerts
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/xauxat-support
ExecStart=/usr/bin/docker compose exec -T support python supportctl.py maintenance
TimeoutStartSec=5min
UMask=0077
StandardOutput=journal
StandardError=journal
