+        usedHosts = S.unions $ map serverHosts usedServers
+    servers <- getUserServers_ c userId storageSrvs
+    alternatives <- maybe (throwE $ CMD PROHIBITED "no independent receive relay configured") pure $
+      L.nonEmpty $ L.filter (isUnusedServer usedHosts) servers
+    (_, srv) <- getNextServer_ alternatives (usedOperatorsHosts servers usedServers)
+    vr <- asks $ smpClientVRange . config
+    (q, qUri, tSess, sessId, serviceId_) <- newRcvQueue c NRMBackground userId connId srv vr SCMInvitation False SMSubscribe
+    let newQueue = (q :: NewRcvQueue) {primary = False}
