+-- | Add a redundant queue until the requested count is reached.
+addConnectionReceiveQueue :: AgentClient -> ConnId -> Int -> AE ()
+addConnectionReceiveQueue c connId target = withAgentEnv c $ do
+  unless (target == 2 || target == 3) $ throwE $ CMD PROHIBITED "target queue count must be two or three"
+  withConnLock c connId "addConnectionReceiveQueue" $
+    withStore c (`getConn` connId) >>= \case
+      SomeConn _ (DuplexConnection cData rqs _) -> do
+        checkRedundantQueue cData
+        when (length rqs < target) $ do
+          when (isJust $ switchingRQ rqs) $ throwE $ CMD PROHIBITED "queue switch in progress"
+          enqueueCommand c "" connId Nothing $ AClientCommand $ QNEW target
+      _ -> throwE $ CMD PROHIBITED "adding a receive queue requires a duplex connection"
+
+-- | Simulate failed sends for 30 seconds on one test connection only.
+simulateConnectionRelayOutage :: AgentClient -> ConnId -> Int -> AE ()
+simulateConnectionRelayOutage c connId count = withAgentEnv c $ do
+  unless (count >= 0 && count <= 2) $ throwE $ CMD PROHIBITED "outage count must be zero, one or two"
+  if count == 0
+    then atomically $ TM.delete connId $ smpTestOutages c
+    else do
+      ConnectionStats {sndQueuesInfo} <- getConnectionServers' c connId
+      let activeServers = [sndServer | SndQueueInfo {sndServer, status = Active} <- sndQueuesInfo]
+      unless (length activeServers > count) $ throwE $ CMD PROHIBITED "keep at least one active relay"
+      expires <- addUTCTime 30 <$> liftIO getCurrentTime
+      atomically $ TM.insert connId (take count activeServers, expires) $ smpTestOutages c
+
