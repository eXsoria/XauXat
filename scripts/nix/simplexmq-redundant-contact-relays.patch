+hasSndMsgDelivery :: DB.Connection -> ConnId -> SndQueue -> InternalId -> IO Bool
+hasSndMsgDelivery db connId SndQueue {dbQueueId} msgId =
+  maybeFirstRow' False fromOnlyBI $
+    DB.query db "SELECT 1 FROM snd_message_deliveries WHERE conn_id = ? AND snd_queue_id = ? AND internal_id = ? AND failed = 0 LIMIT 1" (connId, dbQueueId, msgId)
+
+-- Delivery states: 0 is pending, 1 is a broken work item, 2 is accepted.
+-- Keep pending copies after the first acceptance: the accepting relay can
+-- become unavailable before the recipient reads its copy.
+finishSndMsgDelivery :: DB.Connection -> ConnId -> SndQueue -> InternalId -> Bool -> IO Bool
+finishSndMsgDelivery db connId sq@SndQueue {dbQueueId} msgId delivered = do
+  lockConnForUpdate db connId
+  pending <- hasSndMsgDelivery db connId sq msgId
+  if not pending then pure False else do
+    accepted <- maybeFirstRow' False fromOnlyBI $
+      DB.query db "SELECT 1 FROM snd_message_deliveries WHERE conn_id = ? AND internal_id = ? AND failed = 2 LIMIT 1" (connId, msgId)
+    if delivered
+      then DB.execute db "UPDATE snd_message_deliveries SET failed = 2 WHERE conn_id = ? AND internal_id = ? AND snd_queue_id = ?" (connId, msgId, dbQueueId)
+      else DB.execute db "DELETE FROM snd_message_deliveries WHERE conn_id = ? AND internal_id = ? AND snd_queue_id = ?" (connId, msgId, dbQueueId)
+    complete <- (== 0) <$> countPendingSndDeliveries_ db connId msgId
+    when complete $ do
+      DB.execute db "DELETE FROM snd_message_deliveries WHERE conn_id = ? AND internal_id = ?" (connId, msgId)
+      deleteSndMsgDelivery db connId sq msgId (accepted || delivered)
+    pure $ not accepted && (delivered || complete)
+
