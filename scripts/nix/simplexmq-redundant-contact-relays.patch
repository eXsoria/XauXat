+addRedundantQueues :: AgentClient -> ConnId -> AgentClient -> ConnId -> NonEmpty SMPServer -> ExceptT AgentErrorType IO ()
+addRedundantQueues a bId b aId servers =
+  forM_ [(a, bId, b, aId), (b, aId, a, bId)] $ \(receiver, connId, sender, peerConnId) -> do
+    liftIO $ setProtocolServers receiver 1 $ fmap noAuthSrvCfg servers
+    addConnectionReceiveQueue receiver connId $ length servers
+    let statuses = replicate (length servers) Nothing
+    phaseSnd sender peerConnId SPCompleted statuses
+    phaseRcv receiver connId SPCompleted statuses
+    ConnectionStats {rcvQueuesInfo} <- getConnectionServers receiver connId
+    liftIO $ map rcvServer rcvQueuesInfo `shouldMatchList` foldr (:) [] servers
+
+assertSingleDelivery :: AgentClient -> ConnId -> AgentClient -> ConnId -> MsgBody -> ExceptT AgentErrorType IO ()
+assertSingleDelivery sender connId receiver peerConnId body = do
+  msgId <- sendMessage sender connId SMP.noMsgFlags body
+  let messageEvents :: AgentClient -> ExceptT AgentErrorType IO (ConnId, AEvent 'AEConn)
+      messageEvents client = pGet client >>= \case
+        ("", _, AEvt SAENone DOWN {}) -> messageEvents client
+        ("", _, AEvt SAENone UP {}) -> messageEvents client
+        ("", _, AEvt SAEConn QCONT) -> messageEvents client
+        (_, cid, AEvt SAEConn event) -> pure (cid, event)
+        (_, _, AEvt _ event) -> error $ "unexpected event " <> show event
+  Just ((connId', SENT sentId), (peerId, MSG MsgMeta {recipient = (rcvId, _)} _ received)) <-
+    timeout 5_000_000 $ concurrently (messageEvents sender) (messageEvents receiver)
+  liftIO $ (connId', sentId) `shouldBe` (connId, msgId)
+  liftIO $ (peerId, received) `shouldBe` (peerConnId, body)
+  ackMessage receiver peerConnId rcvId Nothing
+  forM_ [sender, receiver] $ \client -> do
+    extra <- timeout 250000 $ messageEvents client
+    liftIO $ extra `shouldSatisfy` isNothing
+
